TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Embeddings and generation are different model ids.
# Embeddings default to the local fastembed model so indexing works without a key.
# Set LLM_API_KEY and point LLM_EMBEDDING_MODEL at a remote embeddings id to use an API instead.
QDRANT_URL=http://127.0.0.1:6333
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1
LLM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=gpt-4o-mini
