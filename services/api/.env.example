TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# 4Geeks Student models. These two ids are different.
# Embeddings: perplexity/pplx-embed-v1-0.6b
# Generation: deepseek/deepseek-v4-flash
# With no LLM_API_KEY, indexing uses the local fastembed model.
QDRANT_URL=http://127.0.0.1:6333
LLM_API_KEY=
LLM_API_URL=https://llm.4geeks.ai/v1
LLM_EMBEDDING_MODEL=downtown-miami/openrouter/perplexity/pplx-embed-v1-0.6b
LLM_MODEL=downtown-miami/openrouter/deepseek/deepseek-v4-flash
